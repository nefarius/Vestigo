<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vestigo</RootNamespace>
    <AssemblyName>Vestigo</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Description>Localhost MCP server for offline and realtime WPP trace capture and decoding.</Description>
    <Authors>Benjamin Höglinger-Stelzer</Authors>
    <Copyright>Copyright © Benjamin Höglinger-Stelzer 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/nefarius/Vestigo</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8" />
    <PackageReference Include="MinVer" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Nefarius.Utilities.ETW" Version="2.19.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vestigo.Server.Tests" />
  </ItemGroup>

</Project>
