<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="minisign-net" />
    <PackageReference Include="Nefarius.Vicius.Abstractions" />
    <!--
      Abstractions compiles [JsonSchemaType] against NJsonSchema.Annotations 11.6.1 and
      keeps that package private. System.Text.Json still loads the attribute assembly while
      writing updates.json. Fallout.Common may bring an older NJsonSchema.Annotations, which
      the loader will not use for that 11.6.1.0 reference.
    -->
    <PackageReference Include="NJsonSchema.Annotations" />
    <PackageReference Include="Fallout.Common" />
  </ItemGroup>

</Project>
