{
  "Vestigo": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 5098,
    "ApiTokens": [],
    "Plugins": {
      "Enabled": false,
      "TrustMode": "Disabled"
    },
    "AllowedInputRoots": [],
    "AllowedOutputRoots": [],
    "SymbolServer": null,
    "SymbolCache": null,
    "MaxInputBytes": 4294967296,
    "MaxEvents": 1000000,
    "MaxOutputBytes": 536870912,
    "MaxCaptureDuration": "01:00:00",
    "SpoolRetention": "1.00:00:00",
    "MaxConcurrentCaptures": 4,
    "MaxReadBatch": 200,
    "MaxReadWait": "00:00:30",
    "AttachableSessions": [],
    "BufferSizeKb": 64,
    "FlushTimerSeconds": 1,
    "ClockResolution": "QueryPerformanceCounter",
    "Software": {
      "AllowUninstall": false,
      "ProtectedNames": [],
      "MaxUninstallDuration": "00:30:00"
    },
    "ScheduledTasks": {
      "AllowChanges": false,
      "ProtectedPaths": []
    },
    "Audio": {
      "AllowSetDefault": false,
      "MeterSampleMilliseconds": 200
    },
    "System": {
      "AllowBootConfigurationChanges": false,
      "AllowUacChanges": false
    },
    "Updates": {
      "AllowSelfUpdate": false
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "ModelContextProtocol": "Information"
      }
    }
  }
}
