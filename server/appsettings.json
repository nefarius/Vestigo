{
  "Vestigo": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 5098,
    "ApiTokens": [],
    "AllowedInputRoots": [],
    "AllowedOutputRoots": [],
    "SymbolServer": null,
    "SymbolCache": null,
    "MaxInputBytes": 4294967296,
    "MaxEvents": 1000000,
    "MaxOutputBytes": 536870912,
    "MaxCaptureDuration": "01:00:00",
    "SpoolRetention": "1.00:00:00",
    "MaxConcurrentCaptures": 4,
    "MaxReadBatch": 200,
    "BufferSizeKb": 64,
    "FlushTimerSeconds": 1,
    "ClockResolution": "QueryPerformanceCounter",
    "Software": {
      "AllowUninstall": false,
      "ProtectedNames": [],
      "MaxUninstallDuration": "00:30:00"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "ModelContextProtocol": "Information"
      }
    }
  }
}
