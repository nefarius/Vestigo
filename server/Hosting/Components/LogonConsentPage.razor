@using Vestigo.SystemInfo
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@Model.Title</title>
    <link rel="stylesheet" href="/_content/MudBlazor/MudBlazor.min.css" />
    <style>
        body { margin: 0; background: #f6f4ef; color: #1c1b18; font-family: "Roboto", system-ui, sans-serif; }
        .consent { max-width: 40rem; margin: 2.5rem auto; padding: 0 1.25rem 3rem; }
        .consent-card { background: #fffdf8; border: 1px solid #d8d2c4; border-radius: 8px; padding: 1.25rem 1.4rem; }
        .consent label { display: block; font-size: .875rem; margin: 1rem 0 .35rem; }
        .consent input[type=password] { width: 100%; box-sizing: border-box; padding: .65rem .75rem; border: 1px solid #c8c2b4; border-radius: 4px; font-size: 1rem; }
        .consent-actions { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 1.25rem; }
        .consent button { border: 0; border-radius: 4px; padding: .65rem 1rem; font-size: .95rem; cursor: pointer; }
        .approve { background: #2f5d50; color: #fff; }
        .reject { background: #ece8de; color: #1c1b18; }
        .muted { color: #5c5850; }
        .warn { background: #fff4d6; border: 1px solid #e6c36a; padding: .75rem 1rem; border-radius: 6px; margin: 1rem 0; }
        .error { background: #fdecea; border: 1px solid #e8a0a0; padding: .75rem 1rem; border-radius: 6px; margin: 1rem 0; }
        .ok { background: #e8f5ef; border: 1px solid #8fbfb0; padding: .75rem 1rem; border-radius: 6px; margin: 1rem 0; }
        @@media (prefers-color-scheme: dark) {
            body { background: #161513; color: #f0ece4; }
            .consent-card { background: #1f1d1a; border-color: #3a3630; }
            .muted { color: #b4aea2; }
            .consent input[type=password] { background: #161513; color: #f0ece4; border-color: #3a3630; }
            .reject { background: #2a2722; color: #f0ece4; }
        }
    </style>
</head>
<body>
    <main class="consent">
        <p class="muted" style="letter-spacing:.08em;font-size:.75rem;margin:0 0 .35rem;">VESTIGO / CONSENT</p>
        <h1 style="font-size:1.75rem;margin:0 0 1rem;">@Model.Title</h1>
        <div class="consent-card">
            <p><strong>Machine:</strong> @Model.Machine</p>
            @if (!string.IsNullOrEmpty(Model.Operation))
            {
                <p><strong>Operation:</strong> @Model.Operation</p>
            }
            @if (!string.IsNullOrEmpty(Model.Account))
            {
                <p><strong>Account:</strong> @Model.Account</p>
            }
            @if (!string.IsNullOrEmpty(Model.Details))
            {
                <p class="muted">@Model.Details</p>
            }
            @if (Model.HttpWarning)
            {
                <p class="warn">This page was opened over plain HTTP from a non-loopback address. The Windows password will cross the network unencrypted. Use localhost, a trusted LAN, or a TLS-terminating proxy.</p>
            }
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <p class="error">@Model.Error</p>
            }
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <p class="ok">@Model.Message</p>
            }
            @if (Model.ShowForm)
            {
                <form method="post" autocomplete="off">
                    <input type="hidden" name="ticket" value="@Model.Ticket" />
                    @if (!string.IsNullOrEmpty(Model.AntiforgeryField) && !string.IsNullOrEmpty(Model.AntiforgeryValue))
                    {
                        <input type="hidden" name="@Model.AntiforgeryField" value="@Model.AntiforgeryValue" />
                    }
                    <label for="password">Windows password</label>
                    <input id="password" name="password" type="password" required maxlength="256" autocomplete="current-password" />
                    @if (Model.RemainingAttempts is > 0 and < 3)
                    {
                        <p class="muted">Remaining attempts: @Model.RemainingAttempts</p>
                    }
                    <div class="consent-actions">
                        <button class="approve" type="submit" name="decision" value="approve">Approve</button>
                        <button class="reject" type="submit" name="decision" value="reject" formnovalidate>Reject</button>
                    </div>
                </form>
                <p class="muted" style="margin-top:1.25rem;">The password is verified on this machine and is never returned to the MCP client or written to logs.</p>
            }
        </div>
    </main>
</body>
</html>

@code {
    [Parameter, EditorRequired]
    public LogonConsentPageModel Model { get; set; } = new();
}
