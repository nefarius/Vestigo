@foreach (var field in Values.ToArray())
{
    var path = string.IsNullOrEmpty(Prefix) ? field.Key : Prefix + ":" + field.Key;
    @if (ScalarsOnly && field.Value is JsonObject) { }
    else if (field.Value is JsonObject nested && !ConfigurationFieldMetadata.IsStringDictionary(path))
    {
        <ConfigFields Values="nested" Prefix="@path" Search="@Search" ValidityChanged="ValidityChanged" />
    }
    else
    {
        string key = field.Key;
        <div @key="path" hidden="@(!string.IsNullOrWhiteSpace(Search) && !path.Contains(Search, StringComparison.OrdinalIgnoreCase))">
        @if (field.Value is JsonValue flagValue && flagValue.TryGetValue<bool>(out bool flag))
        {
            <MudSwitch T="bool" Value="flag" ValueChanged="@(value => Set(key, JsonValue.Create(value)))" Label="@path" Color="Color.Primary" />
        }
        else if (ConfigurationFieldMetadata.TryGetEnum(path, out Type enumType, out bool flags) &&
                 field.Value is JsonValue enumValue && enumValue.TryGetValue<string>(out string? enumName))
        {
            if (flags)
            {
                <ConfigFlagsField Label="@path" EnumType="enumType" Value="@enumName" ValueChanged="@(value => Set(key, JsonValue.Create(value)))"
                                  ValidChanged="@(valid => Report(key, valid))" />
            }
            else
            {
                <ConfigEnumField Label="@path" EnumType="enumType" Value="@enumName" ValueChanged="@(value => Set(key, JsonValue.Create(value)))"
                                 ValidChanged="@(valid => Report(key, valid))" />
            }
        }
        else if (field.Value is JsonArray strings && ConfigurationFieldMetadata.IsStringList(path))
        {
            <MudTextField T="string" Immediate="true" Label="@path" Value="@string.Join("\n", strings.Select(item => item?.GetValue<string>()))"
                          ValueChanged="@(value => Set(key, new JsonArray(value.Replace("\r", "").Split('\n', StringSplitOptions.RemoveEmptyEntries).Select(line => (JsonNode?)JsonValue.Create(line)).ToArray())))"
                          Lines="3" Variant="Variant.Outlined" Class="my-3" HelperText="One entry per line. Leave empty to clear the list." />
        }
        else if (field.Value is JsonArray roots && ConfigurationFieldMetadata.IsNamedRoots(path))
        {
            <ConfigRootsEditor Label="@path" Value="roots" ValueChanged="@(value => Set(key, value))" ValidChanged="@(valid => Report(key, valid))" />
        }
        else if (field.Value is JsonObject dictionary && ConfigurationFieldMetadata.IsStringDictionary(path))
        {
            <ConfigDictionaryEditor Label="@path" Value="dictionary" RequireSha256="@path.EndsWith("PackageHashes", StringComparison.Ordinal)"
                                    KeyLabel="@(path.EndsWith("PackageHashes", StringComparison.Ordinal) ? "Plugin ID" : "Name")"
                                    ValueLabel="@(path.EndsWith("PackageHashes", StringComparison.Ordinal) ? "SHA-256" : "Value")"
                                    HelperText="@(path.EndsWith("PackageHashes", StringComparison.Ordinal) ? "SHA-256 pin for one plugin deployment. Leave the list empty when pins are not used." : "One entry per row. Leave the list empty to clear it.")"
                                    ValueChanged="@(value => Set(key, value))" ValidChanged="@(valid => Report(key, valid))" />
        }
        else if (ConfigurationFieldMetadata.IsByteCount(path, out Type byteType) && field.Value is JsonValue bytes && bytes.GetValueKind() == JsonValueKind.Number)
        {
            <ConfigByteField Label="@path" IntegerType="byteType" Value="bytes" ValueChanged="@(value => Set(key, value))" ValidChanged="@(valid => Report(key, valid))" />
        }
        else if (ConfigurationFieldMetadata.IsDuration(path) && field.Value is JsonValue duration && duration.TryGetValue<string>(out string? durationText))
        {
            <ConfigDurationField Label="@path" Value="@durationText" ValueChanged="@(value => Set(key, JsonValue.Create(value)))" ValidChanged="@(valid => Report(key, valid))" />
        }
        else
        {
            bool structured = field.Value is JsonArray or JsonObject;
            string text = _drafts.TryGetValue(key, out string? draft) ? draft :
                field.Value is JsonValue scalar && scalar.TryGetValue<string>(out string? s) ? s : field.Value?.ToJsonString(ConfigurationEditor.JsonOptions) ?? "";
            <MudTextField T="string" Immediate="true" Value="@text" ValueChanged="@(value => Change(key, value, field.Value))" Label="@path"
                          Lines="@(structured ? 4 : 1)" Variant="Variant.Outlined" Class="my-3"
                          InputType="@(path.Contains("Secret", StringComparison.OrdinalIgnoreCase) && !structured ? InputType.Password : InputType.Text)"
                          HelperText="@(structured ? "JSON value without a dedicated editor. It must stay valid JSON of the same type." : ConfigurationFieldMetadata.BundledExecutableHint(path) ?? "")" />
        }
        @if (_errors.TryGetValue(key, out string? error)) { <MudAlert Severity="Severity.Error">@error</MudAlert> }
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public JsonObject Values { get; set; } = null!;
    [Parameter] public bool ScalarsOnly { get; set; }
    [Parameter] public EventCallback<(string Path, bool Valid)> ValidityChanged { get; set; }
    [Parameter] public string Prefix { get; set; } = "";
    [Parameter] public string Search { get; set; } = "";
    private readonly Dictionary<string, string> _drafts = [];
    private readonly Dictionary<string, string> _errors = [];
    private void Set(string key, JsonNode? value) => Values[key] = value;
    private string FullPath(string key) => string.IsNullOrEmpty(Prefix) ? key : Prefix + ":" + key;
    private Task Report(string key, bool valid) => ValidityChanged.InvokeAsync((FullPath(key), valid));
    private async Task Change(string key, string text, JsonNode? previous)
    {
        _drafts[key] = text;
        try
        {
            JsonNode? value = previous is JsonArray or JsonObject ? JsonNode.Parse(text) :
                previous is JsonValue scalar && scalar.GetValueKind() == JsonValueKind.Number ? JsonNode.Parse(text) :
                string.IsNullOrEmpty(text) && previous is null ? null : JsonValue.Create(text);
            if (previous is JsonArray && value is not JsonArray || previous is JsonObject && value is not JsonObject ||
                previous is JsonValue number && number.GetValueKind() == JsonValueKind.Number && value?.GetValueKind() != JsonValueKind.Number)
                throw new JsonException();
            Set(key, value); _errors.Remove(key);
            await ValidityChanged.InvokeAsync((FullPath(key), true));
        }
        catch (JsonException)
        {
            _errors[key] = $"{FullPath(key)}: enter valid JSON of the existing type.";
            await ValidityChanged.InvokeAsync((FullPath(key), false));
        }
    }
}
