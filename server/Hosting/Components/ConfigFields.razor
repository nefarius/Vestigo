@foreach (var field in Values.ToArray())
{
    var path = string.IsNullOrEmpty(Prefix) ? field.Key : Prefix + ":" + field.Key;
    @if (ScalarsOnly && field.Value is JsonObject) { }
    else if (field.Value is JsonObject nested && !path.EndsWith("PackageHashes", StringComparison.Ordinal))
    {
        <ConfigFields Values="nested" Prefix="@path" Search="@Search" ValidityChanged="ValidityChanged" />
    }
    else
    {
        <div @key="path" hidden="@(!string.IsNullOrWhiteSpace(Search) && !path.Contains(Search, StringComparison.OrdinalIgnoreCase))">
        @if (field.Value is JsonValue value && value.TryGetValue<bool>(out bool flag))
        {
            <MudSwitch T="bool" Value="flag" ValueChanged="@(v => Set(field.Key, JsonValue.Create(v)))" Label="@path" Color="Color.Primary" />
        }
        else if (ConfigurationFieldMetadata.TypeFor(path) is Type enumType && enumType.IsEnum && !enumType.IsDefined(typeof(FlagsAttribute), false))
        {
            <MudSelect T="string" Label="@path" Value="@(field.Value?.GetValue<string>())" ValueChanged="@(v => Set(field.Key, JsonValue.Create(v)))" Variant="Variant.Outlined" Class="my-3">
                @foreach (string name in Enum.GetNames(enumType))
                {
                    <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
                }
            </MudSelect>
        }
        else if (field.Value is JsonArray strings && ConfigurationFieldMetadata.IsStringList(path))
        {
            <MudTextField T="string" Immediate="true" Label="@path" Value="@string.Join("\n", strings.Select(item => item?.GetValue<string>()))"
                          ValueChanged="@(v => Set(field.Key, new JsonArray(v.Replace("\r", "").Split('\n', StringSplitOptions.RemoveEmptyEntries).Select(line => (JsonNode?)JsonValue.Create(line)).ToArray())))"
                          Lines="3" Variant="Variant.Outlined" Class="my-3" HelperText="One entry per line. Leave empty to clear the list." />
        }
        else
        {
            bool structured = field.Value is JsonArray or JsonObject;
            string text = _drafts.TryGetValue(field.Key, out string? draft) ? draft :
                field.Value is JsonValue scalar && scalar.TryGetValue<string>(out string? s) ? s : field.Value?.ToJsonString(ConfigurationEditor.JsonOptions) ?? "";
            <MudTextField T="string" Immediate="true" Value="@text" ValueChanged="@(v => Change(field.Key, v, field.Value))" Label="@path"
                          Lines="@(structured ? 4 : 1)" Variant="Variant.Outlined" Class="my-3"
                          InputType="@(path.Contains("Secret", StringComparison.OrdinalIgnoreCase) && !structured ? InputType.Password : InputType.Text)"
                          HelperText="@(structured ? "JSON array or object. Lists replace the existing values." : "")" />
        }
        @if (_errors.TryGetValue(field.Key, out string? error)) { <MudAlert Severity="Severity.Error">@error</MudAlert> }
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public JsonObject Values { get; set; } = null!;
    [Parameter] public bool ScalarsOnly { get; set; }
    [Parameter] public EventCallback<(string Path, bool Valid)> ValidityChanged { get; set; }
    [Parameter] public string Prefix { get; set; } = "";
    [Parameter] public string Search { get; set; } = "";
    private readonly Dictionary<string, string> _drafts = [];
    private readonly Dictionary<string, string> _errors = [];
    private void Set(string key, JsonNode? value) => Values[key] = value;
    private async Task Change(string key, string text, JsonNode? previous)
    {
        _drafts[key] = text;
        try
        {
            JsonNode? value = previous is JsonArray or JsonObject ? JsonNode.Parse(text) :
                previous is JsonValue scalar && scalar.GetValueKind() == JsonValueKind.Number ? JsonNode.Parse(text) :
                string.IsNullOrEmpty(text) && previous is null ? null : JsonValue.Create(text);
            if (previous is JsonArray && value is not JsonArray || previous is JsonObject && value is not JsonObject ||
                previous is JsonValue number && number.GetValueKind() == JsonValueKind.Number && value?.GetValueKind() != JsonValueKind.Number)
                throw new JsonException();
            Set(key, value); _errors.Remove(key);
            await ValidityChanged.InvokeAsync(($"{Prefix}:{key}", true));
        }
        catch (JsonException)
        {
            _errors[key] = $"{Prefix}:{key}: enter valid JSON of the existing type.";
            await ValidityChanged.InvokeAsync(($"{Prefix}:{key}", false));
        }
    }
}
