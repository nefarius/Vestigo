<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vestigo.Server.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="minisign-net" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure installer logic, shared with the net48 custom action assembly. -->
    <Compile Include="..\..\installer\Vestigo.Installer.Actions\Logic\*.cs" LinkBase="InstallerLogic" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\build\_build.csproj" />
    <ProjectReference Include="..\..\server\Vestigo.Server.csproj" />
    <ProjectReference Include="..\..\examples\Vestigo.ExamplePlugin\Vestigo.ExamplePlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\fixtures\plugins\PluginV1\PluginV1.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\fixtures\plugins\PluginV2\PluginV2.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Exercise a real published plugin, rather than a test assembly accidentally shared by the host. -->
  <Target Name="PublishExamplePluginFixture" AfterTargets="Build">
    <MSBuild Projects="..\..\examples\Vestigo.ExamplePlugin\Vestigo.ExamplePlugin.csproj"
             Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(TargetDir)plugin-fixtures\example\" />
    <MSBuild Projects="..\fixtures\plugins\PluginV1\PluginV1.csproj"
             Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(TargetDir)plugin-fixtures\v1\" />
    <MSBuild Projects="..\fixtures\plugins\PluginV2\PluginV2.csproj"
             Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(TargetDir)plugin-fixtures\v2\" />
  </Target>

</Project>
