<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vestigo.Server.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="minisign-net" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure installer logic, shared with the net48 custom action assembly. -->
    <Compile Include="..\..\installer\Vestigo.Installer.Actions\Logic\*.cs" LinkBase="InstallerLogic" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\build\_build.csproj" />
    <ProjectReference Include="..\..\server\Vestigo.Server.csproj" />
  </ItemGroup>

  <Target Name="CopyServerRuntimeConfig" AfterTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_ServerRuntimeConfig>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\server\bin\$(Configuration)\$(TargetFramework)\Vestigo.runtimeconfig.json'))</_ServerRuntimeConfig>
    </PropertyGroup>
    <Copy SourceFiles="$(_ServerRuntimeConfig)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(_ServerRuntimeConfig)')" />
  </Target>

</Project>
